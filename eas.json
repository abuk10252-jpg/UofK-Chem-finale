{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "ORG_GRADLE_PROJECT_kotlinVersion": "2.1.0"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "ORG_GRADLE_PROJECT_kotlinVersion": "2.1.0"
      }
    }
  }
}
